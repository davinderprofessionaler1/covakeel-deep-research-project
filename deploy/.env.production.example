# Public DNS records must point both names to the VPS before deployment.
DOMAIN=covakeel.example.com
ADMIN_DOMAIN=admin.covakeel.example.com
TLS_EMAIL=admin@example.com

POSTGRES_DB=covakeel
POSTGRES_USER=covakeel
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

OTP_SECRET=replace-with-a-long-random-otp-secret
OTP_TTL_MINUTES=10
SESSION_TTL_DAYS=30

ADMIN_INTERNAL_API_KEY=replace-with-a-long-random-internal-api-key
ADMIN_SETTINGS_SECRET=replace-with-a-long-random-settings-encryption-secret
ADMIN_INITIAL_NAME=CoVakeel administrator
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-initial-admin-password
ADMIN_SESSION_DAYS=7

# Optional SMTP fallback. These can instead be saved after login in Admin Settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Small local model defaults. Increase only when the server has sufficient RAM/GPU.
AI_CONTEXT_TOKENS=4096
AI_MAX_OUTPUT_TOKENS=160
AI_MAX_MESSAGES=20
AI_MAX_MESSAGE_CHARS=12000
COVAKEEL_KNOWLEDGE_MAX_CONTEXT_CHARS=5000

