FROM node:22-bookworm-slim AS build

RUN corepack enable && corepack prepare pnpm@10.18.3 --activate
WORKDIR /app/landing-page

COPY landing-page/package.json landing-page/pnpm-lock.yaml landing-page/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY landing-page/ ./
RUN pnpm build

FROM node:22-bookworm-slim AS runtime

RUN apt-get update \
  && apt-get install -y --no-install-recommends libreoffice-writer poppler-utils \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@10.18.3 --activate

WORKDIR /app/landing-page
COPY landing-page/package.json landing-page/pnpm-lock.yaml landing-page/pnpm-workspace.yaml ./
RUN pnpm install --prod --frozen-lockfile

COPY landing-page/server ./server
COPY landing-page/database ./database
COPY --from=build /app/landing-page/dist ./dist

RUN mkdir -p storage/uploads

ENV NODE_ENV=production
EXPOSE 3001
CMD ["node", "server/index.js"]

