# Local server. Use 0.0.0.0 so phones and PCs on the same Wi-Fi can connect.
COVAKEEL_HOST=0.0.0.0
COVAKEEL_PORT=8080

# AI provider. The local MVP currently supports Ollama.
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=covakeel-local:latest
OLLAMA_KEEP_ALIVE=30m

# Keep local prompts bounded for acceptable CPU latency.
AI_CONTEXT_TOKENS=4096
AI_MAX_OUTPUT_TOKENS=160
AI_MAX_MESSAGES=20
AI_MAX_MESSAGE_CHARS=12000

# Production default: only records marked verification_status=approved are loaded.
COVAKEEL_KNOWLEDGE_INDEX=knowledge/approved/chunks.jsonl
COVAKEEL_ALLOW_PENDING_KNOWLEDGE=false
COVAKEEL_KNOWLEDGE_MAX_CONTEXT_CHARS=5000

