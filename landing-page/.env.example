# Express
PORT=3001
CLIENT_ORIGIN=http://127.0.0.1:5173

# PostgreSQL. Create the database and run database/schema.sql first.
DATABASE_URL=postgresql://covakeel:change-me@127.0.0.1:5432/covakeel
DATABASE_SSL=false

# Passwordless email authentication
APP_URL=http://127.0.0.1:3001/workspace
AI_SERVICE_URL=http://127.0.0.1:8080
OTP_SECRET=replace-with-a-long-random-secret
OTP_TTL_MINUTES=10
SESSION_TTL_DAYS=30
COOKIE_SECURE=false

# Local-only fallback. Never enable this on a public/live server.
AUTH_DEV_MODE=false

# SMTP provider (Brevo, SendGrid SMTP, Amazon SES, Gmail Workspace, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CoVakeel <no-reply@example.com>

# Must match the admin API value so saved SMTP credentials can be decrypted.
ADMIN_SETTINGS_SECRET=replace-with-the-same-long-random-secret-used-by-admin
